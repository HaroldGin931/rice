<Layouts.app flash={@flash}>
  <div class="mx-auto max-w-md">
    <%= if @semi_user do %>
      <div class="rounded-2xl border border-zinc-200 bg-white p-8 text-center shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <div class="mx-auto mb-5 flex size-16 items-center justify-center rounded-full bg-gradient-to-br from-indigo-500 to-violet-500 text-2xl font-bold text-white">
          {String.upcase(String.first(@semi_user["handle"] || @semi_user["sub"] || "?"))}
        </div>
        <h1 class="text-xl font-bold">{@semi_user["handle"] || "匿名用户"}</h1>
        <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">已通过 Semi 身份验证登录</p>

        <dl class="mt-6 divide-y divide-zinc-100 text-left text-sm dark:divide-zinc-800">
          <div class="flex items-center justify-between gap-4 py-2.5">
            <dt class="text-zinc-500 dark:text-zinc-400">用户 ID</dt>
            <dd class="font-mono text-xs break-all text-right">{@semi_user["sub"]}</dd>
          </div>
          <div class="flex items-center justify-between gap-4 py-2.5">
            <dt class="text-zinc-500 dark:text-zinc-400">用户名</dt>
            <dd class="font-medium">{@semi_user["handle"] || "—"}</dd>
          </div>
          <div class="flex items-center justify-between gap-4 py-2.5">
            <dt class="text-zinc-500 dark:text-zinc-400">手机验证</dt>
            <dd>{verified_badge(@semi_user["phone_verified"])}</dd>
          </div>
          <div class="flex items-center justify-between gap-4 py-2.5">
            <dt class="text-zinc-500 dark:text-zinc-400">邮箱验证</dt>
            <dd>{verified_badge(@semi_user["email_verified"])}</dd>
          </div>
          <div class="flex items-center justify-between gap-4 py-2.5">
            <dt class="text-zinc-500 dark:text-zinc-400">钱包地址</dt>
            <dd class="font-mono text-xs">{short_wallet(@semi_user["wallet_address"])}</dd>
          </div>
          <div class="flex items-center justify-between gap-4 py-2.5">
            <dt class="text-zinc-500 dark:text-zinc-400">授权范围</dt>
            <dd class="text-right">{Enum.join(@semi_user["scopes_granted"] || [], ", ")}</dd>
          </div>
        </dl>

        <a
          href={~p"/logout"}
          class="mt-6 inline-flex w-full items-center justify-center rounded-lg bg-zinc-100 px-4 py-2 text-sm font-semibold text-zinc-900 hover:bg-zinc-200 dark:bg-zinc-800 dark:text-zinc-100 dark:hover:bg-zinc-700"
        >
          退出登录
        </a>
      </div>
    <% else %>
      <div class="rounded-2xl border border-zinc-200 bg-white p-10 text-center shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <h1 class="text-2xl font-bold">Rice</h1>
        <p class="mt-2 text-sm leading-6 text-zinc-500 dark:text-zinc-400">
          使用 <span class="font-semibold text-zinc-700 dark:text-zinc-300">Semi</span>
          身份登录，体验 OAuth 2.0 授权流程。
        </p>
        <a
          href={~p"/login"}
          class="mt-8 inline-flex items-center justify-center gap-2 rounded-full bg-zinc-900 px-6 py-3 text-sm font-semibold text-white hover:bg-zinc-700 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-300"
        >
          <span class="flex size-5 items-center justify-center rounded-md bg-gradient-to-br from-indigo-500 to-violet-500 text-xs font-bold text-white">
            S
          </span>
          使用 Semi 登录
        </a>
      </div>
    <% end %>
  </div>
</Layouts.app>
